{
  "name": "nodedr-pos-backend",
  "version": "1.7.0",
  "private": true,
  "description": "Offline POS backend: API, SQLite via Prisma, receipt PDF/print generation",
  "author": "Raktim Ranjit <mail@raktimranjit.com> (https://github.com/Raktim94)",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Raktim94/nodedr-pos.git"
  },
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "node-forge": "^1.4.3",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "read-excel-file": "^9.3.17",
    "usb": "2.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^7.10.1"
  },
  "overrides": {
    "fast-uri": ">=4.2.3",
    "body-parser": ">=2.4.0",
    "@hono/node-server": ">=2.1.11",
    "hono": ">=4.13.20",
    "effect": ">=3.22.1 <4",
    "valibot": ">=1.4.2",
    "deepmerge-ts": ">=8.0.0",
    "mysql2": ">=3.22.0"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "better-sqlite3": true,
    "prisma": true,
    "usb": true
  }
}
