{
  "name": "nodedr-pos-backend",
  "version": "1.5.1",
  "private": true,
  "description": "Offline POS backend: API, SQLite via Prisma, receipt PDF/print generation",
  "author": "Raktim Ranjit <ranjitraktim5@gmail.com> (https://github.com/Raktim94)",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Raktim94/nodedr-pos.git"
  },
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "test": "node --test test/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.15",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "read-excel-file": "^9.3.10",
    "usb": "2.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prisma": "^7.8.0"
  },
  "overrides": {
    "fast-uri": ">=3.1.4",
    "@hono/node-server": ">=2.0.5",
    "valibot": ">=1.4.2",
    "deepmerge-ts": ">=8.0.0",
    "mysql2": ">=3.22.0"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "better-sqlite3": true,
    "prisma": true,
    "usb": true
  }
}
