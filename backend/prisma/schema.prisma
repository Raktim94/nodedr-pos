datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin") // "admin" | "cashier"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ShopSettings {
  id             Int      @id @default(autoincrement())
  shopName       String
  legalName      String?
  address1       String
  address2       String?
  city           String?
  state          String?
  phone          String?
  email          String?
  // Currency
  currencyCode   String   @default("INR") // INR | USD | EUR | GBP
  currencySymbol String   @default("Rs.")
  // Tax / GST
  gstEnabled     Boolean  @default(false)
  gstNumber      String?
  panNumber      String?
  defaultTaxRate Float    @default(0)
  // Loyalty
  loyaltyEnabled Boolean  @default(false)
  pointsPerUnit  Float    @default(0) // points earned per 1 currency unit spent
  pointValue     Float    @default(0) // currency value of 1 point when redeemed
  // Receipt customisation
  receiptHeader  String?
  receiptFooter  String   @default("Thank You! Visit Again.")
  showGst        Boolean  @default(true)
  autoPrintReceipt Boolean @default(false)
  // Direct-USB (ESC/POS) printing — see backend/src/lib/escposReceipt.js.
  // Paper width in mm; only 58 or 80 are meaningful (drives the fixed
  // monospace column count for the raw text layout).
  usbPrinterWidth Int @default(80)
  // How a receipt prints when "auto-print after sale" is on:
  //   "browser" — the OS/browser print dialog (window.print), the default
  //               and what a Windows machine with a printer driver uses.
  //   "usb"     — raw ESC/POS straight to the USB thermal printer, with NO
  //               modal dialog. Required on a headless/kiosk Debian till
  //               where the browser print dialog has no configured printer
  //               and would otherwise hang the screen after every sale.
  autoPrintMethod String @default("browser")
  // Inventory
  lowStockAlert  Int      @default(5)
  allowNegativeStock Boolean @default(false)
  // Address lookup (see PinCode below)
  pincode        String?
  // Authorised-signatory signature printed on A4 invoices and receipts.
  // Stored as a file under data/signatures/ (see lib/signatures.js) — only
  // the file name lives here, so settings reads stay small and fast.
  signatureFile  String?
  signatoryName  String?
  // "receipt" = 80mm thermal-style PDF, "a4" = full tax invoice PDF.
  invoiceLayout  String   @default("receipt")
  // Merchant UPI id (VPA) — drives the dynamic UPI QR shown at checkout
  // and printed on invoices.
  upiId          String?
  termsText      String?
}

model Product {
  id            Int           @id @default(autoincrement())
  barcode       String        @unique
  // Separate from `barcode` — this is the shared key used to match a
  // product against an external catalog (e.g. an e-commerce storefront)
  // over the External API below. Optional: most shops never link a
  // product externally, and SQLite's unique index allows any number of
  // NULLs, so leaving it blank never collides with another blank one.
  sku           String?       @unique
  name          String
  category      String?
  hsn           String?
  unit          String? // UQC code, e.g. "PCS", "KGS" — see frontend/lib/masters.ts UQC_UNITS
  purchasePrice Float
  sellingPrice  Float
  taxRate       Float         @default(0) // GST % for this product
  discountType  String?       // "percent" | "amount" | null (no standing discount)
  discountValue Float         @default(0) // interpreted per discountType; applied automatically at checkout
  stock         Int           @default(0)
  // Serial / IMEI tracking: when on, every unit is a SerialUnit row, stock
  // is the count of IN_STOCK units, and a sale must name the exact units.
  trackSerial   Boolean       @default(false)
  warrantyMonths Int          @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  invoiceItems  InvoiceItem[]
  returnItems   ReturnItem[]
  serials       SerialUnit[]

  @@index([name])
  @@index([category])
}

// One physical unit of a serial-tracked product (a phone's IMEI, a laptop's
// serial number...). Globally unique — an IMEI can only exist once — and
// the warranty clock starts when the unit is sold.
model SerialUnit {
  id             Int          @id @default(autoincrement())
  productId      Int
  serial         String       @unique
  status         String       @default("IN_STOCK") // IN_STOCK | SOLD | DEFECTIVE
  invoiceItemId  Int?
  soldAt         DateTime?
  warrantyEndsAt DateTime?
  note           String?
  createdAt      DateTime     @default(now())
  product        Product      @relation(fields: [productId], references: [id])
  invoiceItem    InvoiceItem? @relation(fields: [invoiceItemId], references: [id])
  events         SerialEvent[]

  @@index([productId, status])
  @@index([invoiceItemId])
}

// Append-only history of a serial: received, sold, returned, claimed...
model SerialEvent {
  id        Int        @id @default(autoincrement())
  serialId  Int
  type      String // RECEIVED | SOLD | RETURNED | CLAIM | NOTE
  invoiceId Int?
  note      String?
  createdAt DateTime   @default(now())
  serial    SerialUnit @relation(fields: [serialId], references: [id], onDelete: Cascade)

  @@index([serialId])
}

model Customer {
  id            Int       @id @default(autoincrement())
  name          String
  phone         String    @unique
  email         String?
  loyaltyPoints Int       @default(0)
  totalSpent    Float     @default(0)
  totalDue      Float     @default(0) // outstanding credit ("udhaar") owed by this customer
  creditBalance Float     @default(0) // store credit owed TO the customer (e.g. from a return kept as balance)
  visits        Int       @default(0)
  createdAt     DateTime  @default(now())
  invoices      Invoice[]
  duePayments   CustomerDuePayment[]
  returns       Return[]
}

// A record of each payment a customer makes against their running due
// balance — kept as its own audit trail rather than just decrementing
// Customer.totalDue with no history.
model CustomerDuePayment {
  id         Int      @id @default(autoincrement())
  customerId Int
  amount     Float
  note       String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])
}

model Invoice {
  id             Int           @id @default(autoincrement())
  invoiceNumber  String        @unique
  customerId     Int?
  customerName   String        @default("Walk-in Customer")
  customerPhone  String?
  subtotal       Float // sum of line bases, pre-discount, pre-tax
  discountType   String? // "percent" | "amount"
  discountValue  Float         @default(0)
  discountAmount Float         @default(0) // manual discount in currency
  taxAmount      Float         @default(0)
  loyaltyDiscount Float        @default(0) // currency value of redeemed points
  totalAmount    Float // final payable
  paymentMethod  String        @default("CASH") // CASH | UPI | CARD
  amountPaid     Float         @default(0)
  changeDue      Float         @default(0)
  dueAmount      Float         @default(0) // unpaid shortfall added to the customer's running due ("udhaar")
  previousDuePaid Float        @default(0) // old due the customer cleared as part of this same bill
  returnValue    Float         @default(0) // value of items returned on this bill, netted against the sale
  creditApplied  Float         @default(0) // store credit the customer spent on this bill
  refundValue    Float         @default(0) // paid back to the customer (returns beyond the purchase) as cash or credit
  refundMode     String? // "CASH" | "CREDIT" — how refundValue was settled
  pointsRedeemed Int           @default(0)
  pointsEarned   Int           @default(0)
  // Where the bill came from: "POS" (till), "API" (external storefront via
  // the External API / MCP). externalRef + apiKeyId make an API bill
  // idempotent — retrying the same order never double-bills.
  source         String        @default("POS")
  externalRef    String?
  apiKeyId       Int?
  cashierName    String?
  // Customer's signature captured at the till (file under data/signatures/).
  customerSignature String?
  createdAt      DateTime      @default(now())
  customer       Customer?     @relation(fields: [customerId], references: [id])
  items          InvoiceItem[]
  returns        Return[]

  @@unique([apiKeyId, externalRef])
  @@index([createdAt])
  @@index([customerId])
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  productId Int
  name      String
  unit      String? // snapshot of the product's UQC at time of sale
  quantity  Int
  price     Float // unit selling price at time of sale
  taxRate   Float   @default(0)
  taxAmount Float   @default(0) // tax for this line (on discounted base)
  total     Float // line total incl. tax, after prorated discount
  warrantyMonths Int @default(0)
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  returnItems ReturnItem[]
  serials   SerialUnit[]

  @@index([invoiceId])
  @@index([productId])
}

// A return against a past invoice — one or more line items, each capped at
// (quantity sold - quantity already returned) so the same unit can't be
// returned twice. "Returned quantity so far" is always computed by summing
// ReturnItem rows for an invoice item (see routes/returns.js) rather than
// stored as a running counter, matching CustomerDuePayment's audit-trail
// pattern elsewhere in this schema.
model Return {
  id           Int          @id @default(autoincrement())
  invoiceId    Int
  customerId   Int?
  totalRefund  Float
  refundMethod String // "CASH" | "UPI" | "CARD" | "DUE_ADJUST"
  note         String?
  createdAt    DateTime     @default(now())
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  items        ReturnItem[]
}

model ReturnItem {
  id            Int         @id @default(autoincrement())
  returnId      Int
  invoiceItemId Int
  productId     Int
  name          String
  quantity      Int
  refundAmount  Float
  return        Return      @relation(fields: [returnId], references: [id])
  invoiceItem   InvoiceItem @relation(fields: [invoiceItemId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])
}

// --- Bulk reference data, admin-imported from CSV (see routes/masters.js) ---
// Large/volatile government datasets (full HSN/SAC catalogs, PIN codes,
// IFSC) are deliberately NOT bundled with the app — see README > Reference
// data & validation. These tables just give the admin somewhere to load
// the official file into, if/when they want autocomplete and lookups.

// A credential for an external system (e.g. an e-commerce storefront) to
// call the External Stock API (see routes/external.js). The plaintext key
// is shown to the admin exactly once, at creation — only its SHA-256 hash
// is ever stored, same principle as a password hash. `webhookUrl`, when
// set, is where this integration is notified (HMAC-signed with its own
// `webhookSecret`) whenever a linked product's stock changes here, so a
// connected storefront can mirror stock live instead of only pulling it.
model ApiKey {
  id            Int       @id @default(autoincrement())
  name          String
  // First 8 hex chars of the key, kept only so the admin list can show
  // "which key is this" without ever re-displaying the full secret.
  keyPrefix     String
  keyHash       String    @unique
  // Read-only keys can only look up stock; write keys may also adjust it
  // (used by a storefront reporting its own sales back to the POS).
  canWrite      Boolean   @default(false)
  // Comma-separated capability list, least-privilege by default:
  //   products:read  stock:write  bills:write  bills:read  warranty:read
  scopes        String    @default("products:read")
  webhookUrl    String?
  webhookSecret String?
  lastUsedAt    DateTime?
  revoked       Boolean   @default(false)
  createdAt     DateTime  @default(now())
}

model TaxCode {
  id          Int     @id @default(autoincrement())
  type        String // "HSN" | "SAC"
  code        String
  description String
  gstRate     Float?

  @@unique([type, code])
}

model PinCode {
  pincode  String  @id
  area     String?
  district String?
  state    String?
}

model IfscCode {
  ifsc     String  @id
  bank     String?
  branch   String?
  address  String?
  district String?
  state    String?
}
