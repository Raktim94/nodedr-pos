# Local (non-Docker) development only.
# The browser never uses this — it's the server-side target the Next.js dev
# server proxies /api/* to. Defaults to http://localhost:4000 if unset.
BACKEND_URL=http://localhost:4000

# Public URL this instance is reached at. Only used to build absolute URLs in
# robots.txt/sitemap.xml/Open Graph tags. Set this if you're exposing the
# register on a real domain (e.g. a VPS deployment); irrelevant for a
# shop-LAN-only install. Defaults to http://localhost:1994 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:1994
