// NodeDR POS — MSIX backend entry point, spawned directly as a plain child
// process by open-pos.exe (packaging/windows/msix/launcher/Program.cs) —
// there is no Windows Service and no WinSW in this package; see
// AppxManifest.xml.template's header comment for why.
//
// PORT/NODE_ENV/FRONTEND_ORIGIN/COOKIE_SECURE/DATABASE_URL/CHECKPOINT_DISABLE/
// PRISMA_HIDE_UPDATE_MESSAGE all come from the environment block
// Program.cs's StartChild() sets on the child process it spawns for this
// script. This wrapper only adds what's specific to the MSIX path:
//
// 1. A real random JWT_SECRET. The EXE install lets backend/src/lib/secret.js
//    write one to a path relative to its own source file, then redirects
//    that path out of Program Files with an NTFS junction (mklink /J) created
//    at install time. MSIX's package root is read-only at runtime with no
//    install-time hook to create a junction, so that write would fail. Fixed
//    here — NOT by patching secret.js — by generating/reading the same kind
//    of random secret directly at a writable MSIX-appropriate path
//    (C:\ProgramData\NodeDRPOS\.jwt-secret) and passing it in as
//    JWT_SECRET, which secret.js already checks first before ever touching
//    its own file path.
// 2. `prisma migrate deploy` on every start — the NSIS/EXE installer runs
//    this once at install time (a hook MSIX has no equivalent of); running
//    it here instead covers both first-run schema creation and applying a
//    future version's migrations on upgrade. `migrate deploy` only applies
//    migrations not already recorded, so it's a no-op on every boot after
//    the first.
//
// MANAGE_FIREWALL is deliberately NOT set here (unlike an earlier,
// service-based draft of this file): this MSIX build is foreground-only
// (see AppxManifest.xml.template's header comment) and Program.cs binds the
// frontend to 127.0.0.1 only, so there is no LAN-facing port to open a
// firewall rule for. backend/src/server.js's ensureFirewallRules() stays a
// no-op here, same as it already is for Docker/Debian/dev.

const path = require("path");
const fs = require("fs");
const crypto = require("crypto");
const { execFileSync } = require("child_process");

const dataDir = "C:\\ProgramData\\NodeDRPOS";
for (const sub of ["", "logs", "backups"]) {
  fs.mkdirSync(path.join(dataDir, sub), { recursive: true });
}

if (!process.env.JWT_SECRET) {
  const secretPath = path.join(dataDir, ".jwt-secret");
  if (fs.existsSync(secretPath)) {
    process.env.JWT_SECRET = fs.readFileSync(secretPath, "utf8").trim();
  } else {
    const secret = crypto.randomBytes(48).toString("hex");
    fs.writeFileSync(secretPath, secret, { mode: 0o600 });
    process.env.JWT_SECRET = secret;
  }
}

const backendDir = path.join(__dirname, "..", "backend");
try {
  // stdio: "pipe" (execFileSync's default), NOT "inherit" — this process's
  // own stdout/stderr are themselves redirected pipes (Program.cs launches
  // it with RedirectStandardOutput/Error=true so it can capture them into
  // backend.log), and capturing explicitly here means the real error text
  // reaches that log instead of depending on nested stdio inheritance.
  // That's exactly what surfaced the real bug below (2026-08-14 CI):
  //
  // cwd is deliberately dataDir, NOT backendDir, and --config points
  // explicitly at backendDir's prisma.config.js. Confirmed on real Windows
  // CI: running this with cwd: backendDir failed with "EPERM: operation
  // not permitted, mkdir '...backend\node_modules\.cache\prisma'" —
  // Prisma's CLI derives a cache directory from cwd (walking up to the
  // nearest package.json, same convention as the find-cache-dir package),
  // landing inside the MSIX install root, which is read-only at runtime.
  // Reproduced locally: with node_modules read-only, the write is silently
  // swallowed on POSIX (Node reports EACCES, which Prisma's fallback
  // catches) but NOT on Windows, where the same denial surfaces as EPERM —
  // outside whatever error codes that fallback checks for — so it
  // propagates and aborts the whole `migrate deploy` before any table is
  // created. Since the schema/migrations path in prisma.config.js resolves
  // relative to the config file's own location (verified locally), not
  // cwd, running from a writable cwd changes nothing about what gets
  // migrated — only where Prisma's own cache write lands.
  const output = execFileSync(
    process.execPath,
    [
      path.join(backendDir, "node_modules", "prisma", "build", "index.js"),
      "migrate", "deploy",
      "--config", path.join(backendDir, "prisma.config.js"),
    ],
    { cwd: dataDir, env: process.env }
  );
  process.stdout.write(output);
} catch (err) {
  // Fall through rather than exit: server.js's own DB calls will surface the
  // real error if the schema truly isn't usable, matching what happens today
  // when the NSIS installer's migration step fails (it warns, then still
  // installs — see nodedr-pos.nsi's MB_ICONEXCLAMATION message). Forward the
  // real captured output (not just err.message) so a future failure is
  // actually diagnosable from backend.log instead of a bare exception line.
  if (err.stdout) process.stdout.write(err.stdout);
  if (err.stderr) process.stderr.write(err.stderr);
  console.error("prisma migrate deploy failed at startup:", err.message);
}

require(path.join(backendDir, "src", "server.js"));
