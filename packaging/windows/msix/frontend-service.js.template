// NodeDR POS — MSIX frontend service entry point.
//
// Same reasoning as backend-service.js.template: the windows.service manifest
// extension has no environment-variable attribute, so this wrapper supplies
// what the WinSW service XML gives the EXE install today, then requires the
// real, unmodified Next.js standalone server. frontend/ itself is untouched.
//
// Token-substituted by build-msix.ps1 (@FRONTEND_PORT@).
process.env.PORT = process.env.PORT || "@FRONTEND_PORT@";
process.env.NODE_ENV = "production";
// Bound to every interface so a counter tablet or phone on the shop LAN can
// open the register, same as the WinSW service XML today — Windows Firewall
// (registered by the backend service at startup, see MANAGE_FIREWALL in
// backend-service.js.template) is what actually gates access.
process.env.HOSTNAME = process.env.HOSTNAME || "0.0.0.0";
process.env.NEXT_TELEMETRY_DISABLED = "1";

const path = require("path");
require(path.join(__dirname, "..", "frontend", "server.js"));
