<?xml version="1.0" encoding="utf-8"?>
<!--
  NodeDR POS — MSIX package manifest template.

  This is a TEMPLATE, not a file makeappx can pack directly: build-msix.ps1
  substitutes every @TOKEN@ before packing. Two tokens are placeholders that
  must come from YOUR Partner Center account, never invented:

    @PACKAGE_IDENTITY_NAME@       Partner Center -> your app -> Product
                                   management -> App identity -> "Package/
                                   Identity Name"
    @PARTNER_CENTER_PUBLISHER_CN@ Same page -> "Publisher ID" (the CN=... string)

  Pass them to build-msix.ps1 via -PackageIdentityName / -PublisherCn, or set
  $env:NODEDR_MSIX_IDENTITY_NAME / $env:NODEDR_MSIX_PUBLISHER_CN. The build
  fails loudly if either is still a placeholder — see build-msix.ps1.

  Declares NodeDR POS as a full-trust Win32 app (Desktop Bridge). The app
  itself (open-pos.exe, a WebView2-hosted window — see launcher\Program.cs)
  spawns the backend and frontend as plain child processes when it opens and
  stops them when it closes; there is no packaged Windows Service and no
  windows.service extension, so this package only needs the one restricted
  capability every Desktop Bridge app needs (runFullTrust), not
  packagedServices/localSystemServices. See packaging/windows/README.md's
  "MSIX (Microsoft Store)" section for the reasoning and the trade-off this
  implies (foreground-only — no LAN access from other devices while the app
  is closed, unlike the EXE/Docker installs).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="@PACKAGE_IDENTITY_NAME@"
    Publisher="@PARTNER_CENTER_PUBLISHER_CN@"
    Version="@VERSION@.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Nodedr POS</DisplayName>
    <PublisherDisplayName>NODEDR INFOTECH PRIVATE LIMITED</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Offline-first Point of Sale for retail shops — billing, inventory, barcode scanning, GST-inclusive pricing, and receipt printing, all on your own machine.</Description>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <!--
    This has NOT been confirmed against a real Windows install by this
    build — makeappx pack / the Windows App Certification Kit on the
    windows-latest CI runner is the actual validation gate. Do not treat
    this MinVersion as verified fact. 10.0.17763.0 (Windows 10 1809) is
    WebView2's own documented minimum OS; kept here rather than dropped
    further since the app is unusable without it.
  -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.17763.0" />
  </Dependencies>

  <!--
    runFullTrust is required for any Desktop Bridge (Win32-in-MSIX) app —
    unavoidable here since the app spawns node.exe child processes, which a
    sandboxed UWP app cannot do. It is still a RESTRICTED capability:
    Microsoft's certification team reviews it case by case, and declaring
    it correctly does not guarantee approval — but it is the single most
    common restricted capability in the Store (every classic Win32 app
    packaged as MSIX declares it), so certification friction here is
    expected to be materially lower than the previous packagedServices/
    localSystemServices declarations were. This package deliberately does
    NOT declare those two: there is no packaged Windows Service anymore
    (see this file's header comment) to require them.
  -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <!--
      open-pos.exe (packaging/windows/msix/launcher/) IS the real foreground
      app now — a WebView2-hosted window, not a stub. On launch it starts the
      backend and frontend as its own child processes, waits for the
      frontend's port, then navigates the embedded WebView2 control to
      http://localhost:@FRONTEND_PORT@. Closing the window stops both child
      processes (see launcher\Program.cs's JobObject). No windows.service
      extension, no WinSW — see packaging/windows/README.md's "MSIX
      (Microsoft Store)" section for what changed and why.
    -->
    <Application Id="NodeDRPOS" Executable="open-pos.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Nodedr POS"
        Description="Offline-first retail Point of Sale"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
